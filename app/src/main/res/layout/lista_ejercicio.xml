<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101920"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="80dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="36dp">

        <!-- CABECERA: BOTÓN ATRÁS, TÍTULO Y RACHA -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <!-- CONTENEDOR IZQUIERDO: BOTÓN DE ATRÁS + TÍTULO -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- BOTÓN DE FLECHA ATRÁS -->
                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="6dp"
                    android:src="@android:drawable/ic_menu_revert"
                    app:tint="#E67E22"
                    tools:ignore="TouchTargetSizeCheck" />

                <!-- TÍTULO MUSCLE GYM -->
                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MUSCLE GYM"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- RACHA (A LA DERECHA) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Racha"
                    android:textColor="#BDC3C7"
                    android:textSize="11sp" />
            </LinearLayout>
        </RelativeLayout>

        <!-- SUBTÍTULOS -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvNivelSubtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nivel Principiante "
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(Acento Naranja)"
                android:textColor="#E67E22"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDetalleMusculo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="20dp"
            android:text="Fundamentos de Pecho"
            android:textColor="#BDC3C7"
            android:textSize="13sp" />

        <!-- SECCIÓN CENTRAL: LÍNEA LATERAL + TARJETAS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- TIMELINE LATERAL IZQUIERDA -->
            <LinearLayout
                android:layout_width="24dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <!-- Punto 1 -->
                <View
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="54dp"
                    android:background="#3A4D5F" />

                <View
                    android:layout_width="2dp"
                    android:layout_height="125dp"
                    android:background="#2C3E50" />

                <!-- Punto 2 -->
                <View
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="#3A4D5F" />

                <View
                    android:layout_width="2dp"
                    android:layout_height="125dp"
                    android:background="#2C3E50" />

                <!-- Punto 3 -->
                <View
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="#3A4D5F" />

                <View
                    android:layout_width="2dp"
                    android:layout_height="125dp"
                    android:background="#2C3E50" />

                <!-- Punto 4 -->
                <View
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="#3A4D5F" />
            </LinearLayout>

            <!-- LISTA DE RUTINAS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- TARJETA 1 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card1"
                    android:layout_width="match_parent"
                    android:layout_height="125dp"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="#17242E"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#734B24"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvCard1Titulo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Press de Banca Inclinado con Mancuernas"
                                android:textColor="#E67E22"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvCard1Sub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="4 series · 10 reps · Nivel: Iniciación"
                                android:textColor="#BDC3C7"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="105dp"
                            android:layout_height="match_parent"
                            app:cardBackgroundColor="#0D161C"
                            app:cardCornerRadius="12dp"
                            app:strokeColor="#FFFFFF"
                            app:strokeWidth="1dp">

                            <ImageView
                                android:id="@+id/imgCard1"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/captura_de_pantalla_2026_09_25_182537"
                                tools:ignore="ContentDescription" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- TARJETA 2 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card2"
                    android:layout_width="match_parent"
                    android:layout_height="125dp"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="#17242E"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#734B24"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvCard2Titulo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Aperturas con Mancuernas"
                                android:textColor="#E67E22"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvCard2Sub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="3 series · 12 reps · Nivel: Iniciación"
                                android:textColor="#BDC3C7"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="105dp"
                            android:layout_height="match_parent"
                            app:cardBackgroundColor="#0D161C"
                            app:cardCornerRadius="12dp"
                            app:strokeColor="#FFFFFF"
                            app:strokeWidth="1dp">

                            <ImageView
                                android:id="@+id/imgCard2"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/captura_de_pantalla_2026_09_25_182710"
                                tools:ignore="ContentDescription" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- TARJETA 3 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card3"
                    android:layout_width="match_parent"
                    android:layout_height="125dp"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="#17242E"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#734B24"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvCard3Titulo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Flexiones de Pecho\n(Push-ups) de Rodillas"
                                android:textColor="#E67E22"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvCard3Sub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="3 series · al fallo · Nivel: Iniciación"
                                android:textColor="#BDC3C7"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="105dp"
                            android:layout_height="match_parent"
                            app:cardBackgroundColor="#0D161C"
                            app:cardCornerRadius="12dp"
                            app:strokeColor="#FFFFFF"
                            app:strokeWidth="1dp">

                            <ImageView
                                android:id="@+id/imgCard3"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/captura_de_pantalla_2026_09_25_182808"
                                tools:ignore="ContentDescription" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- TARJETA 4 (RECUPERACIÓN ACTIVA) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card4"
                    android:layout_width="match_parent"
                    android:layout_height="125dp"
                    app:cardBackgroundColor="#17242E"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#2C3E50"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvCard4Titulo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Recuperación\nActiva"
                                android:textColor="#E2E8F0"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvCard4Sub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Descanso y Estiramientos Ligeros de Pecho"
                                android:textColor="#BDC3C7"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="105dp"
                            android:layout_height="match_parent"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="12dp"
                            app:strokeColor="#E0E0E0"
                            app:strokeWidth="1dp">

                            <ImageView
                                android:id="@+id/imgCard4"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/captura_de_pantalla_2026_09_25_182856"
                                tools:ignore="ContentDescription" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>